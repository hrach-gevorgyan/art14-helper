<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the app's pure logic. xUnit v3 builds them as an executable;
       the framework matches the app so its internal types are visible. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <!-- Test results go next to the build output (ignored by git), not into the repository root. -->
    <TestingPlatformCommandLineArguments>--results-directory "$(MSBuildProjectDirectory)\bin\TestResults"</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Art14Helper.csproj" />
  </ItemGroup>

</Project>
